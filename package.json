{
  "name": "ygomaster-modding-tool",
  "productName": "ygomaster-modding-tool",
  "version": "0.13.0",
  "description": "YgoMaster LE mod modding tool",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "test:compatibility": "node --test --require ts-node/register test/compatibility.test.ts",
    "test:pipeline": "node scripts/run-pipeline-fixtures.mjs",
    "test": "npm run test:compatibility && node --test --require ts-node/register test/core.test.ts test/cli.test.ts test/catalog.test.ts test/card-custom.test.ts test/layers.test.ts test/target-contract.test.ts test/content-format.test.ts test/id-registry.test.ts test/card-resolver.test.ts test/pipeline-harness.test.ts test/deck-content.test.ts test/shop-content.test.ts test/shop-overlay.test.ts test/localization-content.test.ts test/gate-content.test.ts test/structure-content.test.ts test/regulation-content.test.ts test/atomic-directory.test.ts test/ir-snapshot.test.ts test/content-bundle-loader.test.ts test/ir-projection-writer.test.ts test/ir-compiler.test.ts test/deployment-generation.test.ts test/layered-validation.test.ts test/ui-content-boundary.test.ts test/source-migration.test.ts test/solo-runtime-contract.test.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "benchmark:catalog": "npm run build:cli && node scripts/benchmark-catalog.mjs --size=14000 --rounds=20 --assert",
    "benchmark:resolver": "npm run build:cli && node scripts/benchmark-card-resolver.mjs --assert",
    "benchmark:pipeline": "npm run build:cli && node scripts/benchmark-pipeline.mjs",
    "build:release": "node scripts/build-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "smoke:content-cli": "node scripts/smoke-content-cli.mjs",
    "smoke:layered-campaign": "node scripts/smoke-layered-campaign.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": {
    "name": "niceandneat",
    "email": "niceaneat@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron-forge/plugin-vite": "^7.4.0",
    "@electron-forge/publisher-github": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@storybook/addon-essentials": "^8.1.10",
    "@storybook/addon-interactions": "^8.1.10",
    "@storybook/addon-links": "^8.1.10",
    "@storybook/blocks": "^8.1.10",
    "@storybook/react": "^8.1.10",
    "@storybook/react-vite": "^8.1.10",
    "@storybook/test": "^8.1.10",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.8.0",
    "prettier": "^3.3.2",
    "storybook": "^8.1.10",
    "storybook-addon-remix-react-router": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.2",
    "@fluentui/react-components": "^9.54.2",
    "@fluentui/react-icons": "^2.0.245",
    "@xyflow/react": "^12.0.0-next.24",
    "downshift": "^9.0.6",
    "electron-log": "^5.1.5",
    "electron-squirrel-startup": "^1.0.1",
    "fuse.js": "^7.0.0",
    "glob": "^10.4.2",
    "jsonc-parser": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"
  }
}
